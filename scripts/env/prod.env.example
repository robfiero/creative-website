# AWS deployment settings for UI releases
AWS_REGION=us-east-1

# S3 bucket that hosts the built static site
S3_BUCKET_UI=replace-with-ui-bucket-name

# CloudFront distribution serving the S3 site
CLOUDFRONT_DISTRIBUTION_ID=REPLACE_WITH_DISTRIBUTION_ID

# Optional informational value
UI_DOMAIN=replace-with-ui-domain.example.com
